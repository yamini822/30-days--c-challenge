#include <stdio.h>

#define ZONES 5
#define DAYS 7

/* ---------- Required prototypes ---------- */
void inputData(float temp[ZONES][DAYS], float humidity[ZONES][DAYS], int aqi[ZONES][DAYS]);
void displayData(float temp[ZONES][DAYS], float humidity[ZONES][DAYS], int aqi[ZONES][DAYS]);
void calculateAverages(float temp[ZONES][DAYS], float humidity[ZONES][DAYS], int aqi[ZONES][DAYS],
                       float avgTemp[ZONES], float avgHumidity[ZONES], float avgAQI[ZONES]);
void detectRiskZones(float temp[ZONES][DAYS], float humidity[ZONES][DAYS], int aqi[ZONES][DAYS],
                     int riskDays[ZONES]);
void computeGreenIndex(float avgTemp[ZONES], float avgHumidity[ZONES], float avgAQI[ZONES],
                       float greenIndex[ZONES]);
void displayRanking(float greenIndex[ZONES]);
void displayRecommendations(float avgTemp[ZONES], float avgHumidity[ZONES], float avgAQI[ZONES],
                            int riskDays[ZONES]);

/* ---------- Helper prototypes ---------- */
void clearInput(void);
void printZoneName(int z);
float absDiff(float a, float b);
float clampZero(float x);
float readFloatInRange(const char *label, int zone, int day, float low, float high);
int readIntInRange(const char *label, int zone, int day, int low, int high);
void loadSampleData(float temp[ZONES][DAYS], float humidity[ZONES][DAYS], int aqi[ZONES][DAYS]);

/* ================= main ================= */
int main(void)
{
    float temp[ZONES][DAYS], humidity[ZONES][DAYS];
    int aqi[ZONES][DAYS];
    float avgTemp[ZONES], avgHumidity[ZONES], avgAQI[ZONES], greenIndex[ZONES];
    int riskDays[ZONES];
    int choice, mode;
    int dataReady = 0;

    do
    {
        printf("\n=========== ECOGUARD - CAMPUS ENVIRONMENT MONITOR ===========\n");
        printf("1. Input / Update Data\n");
        printf("2. Display Data\n");
        printf("3. Zone-wise Averages\n");
        printf("4. Detect Risk Days\n");
        printf("5. Green Index and Ranking\n");
        printf("6. Recommendations\n");
        printf("7. Exit\n");
        printf("Enter your choice: ");

        mode = scanf("%d", &choice);
        if (mode == EOF)
            choice = 7;
        else if (mode != 1)
        {
            clearInput();
            choice = 0;
        }

        if (choice >= 2 && choice <= 6 && dataReady == 0)
        {
            printf("\nNo data entered yet. Please choose option 1 first.\n");
            continue;
        }

        switch (choice)
        {
        case 1:
            printf("\n1. Enter readings manually\n2. Load SIMULATED sample data\nChoose: ");
            if (scanf("%d", &mode) != 1)
            {
                clearInput();
                mode = 0;
            }
            if (mode == 1)
            {
                inputData(temp, humidity, aqi);
                dataReady = 1;
            }
            else if (mode == 2)
            {
                loadSampleData(temp, humidity, aqi);
                dataReady = 1;
                printf("\n*** SIMULATED SAMPLE DATA loaded - NOT real campus measurements ***\n");
            }
            else
                printf("Invalid option.\n");
            break;

        case 2:
            displayData(temp, humidity, aqi);
            break;

        case 3:
            calculateAverages(temp, humidity, aqi, avgTemp, avgHumidity, avgAQI);
            {
                int z;
                printf("\n%-15s %10s %12s %8s\n", "Zone", "Avg Temp", "Avg Humidity", "Avg AQI");
                printf("--------------------------------------------------\n");
                for (z = 0; z < ZONES; z++)
                {
                    printZoneName(z);
                    printf("%10.2f %12.2f %8.2f\n", avgTemp[z], avgHumidity[z], avgAQI[z]);
                }
            }
            break;

        case 4:
            detectRiskZones(temp, humidity, aqi, riskDays);
            break;

        case 5:
            calculateAverages(temp, humidity, aqi, avgTemp, avgHumidity, avgAQI);
            computeGreenIndex(avgTemp, avgHumidity, avgAQI, greenIndex);
            displayRanking(greenIndex);
            break;

        case 6:
            calculateAverages(temp, humidity, aqi, avgTemp, avgHumidity, avgAQI);
            detectRiskZones(temp, humidity, aqi, riskDays);
            displayRecommendations(avgTemp, avgHumidity, avgAQI, riskDays);
            break;

        case 7:
            printf("\nExiting EcoGuard. Stay green!\n");
            break;

        default:
            printf("\nInvalid choice. Enter a number from 1 to 7.\n");
        }
    } while (choice != 7);

    return 0;
}

/* ================= Helpers ================= */
void clearInput(void)
{
    int c;
    c = getchar();
    while (c != '\n' && c != EOF)
        c = getchar();
}

void printZoneName(int z)
{
    if (z == 0)
        printf("%-15s", "Academic Block");
    else if (z == 1)
        printf("%-15s", "Hostel");
    else if (z == 2)
        printf("%-15s", "Library");
    else if (z == 3)
        printf("%-15s", "Cafeteria");
    else
        printf("%-15s", "Sports Area");
}

float absDiff(float a, float b)
{
    if (a > b)
        return a - b;
    else
        return b - a;
}

float clampZero(float x)
{
    if (x < 0)
        return 0;
    return x;
}

float readFloatInRange(const char *label, int zone, int day, float low, float high)
{
    float value;
    int ok;
    do
    {
        printf("Zone %d, Day %d - %s: ", zone + 1, day + 1, label);
        ok = scanf("%f", &value);
        if (ok == EOF)
        {
            value = low;
            ok = 1;
        }
        else if (ok != 1)
        {
            clearInput();
            printf("  Invalid input. Enter a number.\n");
        }
        else if (value < low || value > high)
        {
            printf("  Out of range (%.0f to %.0f). Re-enter.\n", low, high);
            ok = 0;
        }
    } while (ok != 1);
    return value;
}

int readIntInRange(const char *label, int zone, int day, int low, int high)
{
    int value, ok;
    do
    {
        printf("Zone %d, Day %d - %s: ", zone + 1, day + 1, label);
        ok = scanf("%d", &value);
        if (ok == EOF)
        {
            value = low;
            ok = 1;
        }
        else if (ok != 1)
        {
            clearInput();
            printf("  Invalid input. Enter a whole number.\n");
        }
        else if (value < low || value > high)
        {
            printf("  Out of range (%d to %d). Re-enter.\n", low, high);
            ok = 0;
        }
    } while (ok != 1);
    return value;
}

/* SIMULATED data for testing only. Includes AQI risk, temp risk,
   humidity risk, a multi-trigger day and a no-risk zone. */
void loadSampleData(float temp[ZONES][DAYS], float humidity[ZONES][DAYS], int aqi[ZONES][DAYS])
{
    float t[ZONES][DAYS] = {
        {30, 31, 32, 33, 31, 30, 32},
        {28, 29, 36, 37, 30, 29, 28},
        {25, 26, 25, 24, 25, 26, 25},
        {32, 33, 34, 35, 36, 33, 32},
        {34, 36, 38, 37, 35, 34, 33}};
    float h[ZONES][DAYS] = {
        {60, 62, 65, 63, 61, 60, 64},
        {70, 75, 82, 85, 72, 70, 71},
        {50, 52, 51, 49, 50, 53, 50},
        {55, 58, 60, 57, 56, 59, 58},
        {45, 48, 50, 47, 46, 44, 45}};
    int a[ZONES][DAYS] = {
        {90, 100, 110, 120, 95, 105, 98},
        {80, 85, 160, 170, 90, 88, 84},
        {40, 45, 50, 42, 48, 44, 46},
        {130, 140, 155, 160, 150, 145, 135},
        {100, 110, 120, 130, 115, 105, 110}};
    int z, d;
    for (z = 0; z < ZONES; z++)
        for (d = 0; d < DAYS; d++)
