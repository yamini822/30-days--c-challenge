}

/* ================= Required functions ================= */
void inputData(float temp[ZONES][DAYS], float humidity[ZONES][DAYS], int aqi[ZONES][DAYS])
{
    int z, d;
    printf("\nEnter readings (Temp 10-50 C, Humidity 0-100 %%, AQI 0-500)\n");
    for (z = 0; z < ZONES; z++)
    {
        printf("\n--- Zone %d: ", z + 1);
        printZoneName(z);
        printf("---\n");
        for (d = 0; d < DAYS; d++)
        {
            temp[z][d] = readFloatInRange("Temperature (C)", z, d, 10, 50);
            humidity[z][d] = readFloatInRange("Humidity (%)", z, d, 0, 100);
            aqi[z][d] = readIntInRange("AQI", z, d, 0, 500);
        }
    }
    printf("\nData stored successfully.\n");
}

void displayData(float temp[ZONES][DAYS], float humidity[ZONES][DAYS], int aqi[ZONES][DAYS])
{
    int z, d;

    printf("\n--- TEMPERATURE MATRIX (C) ---\n%-15s", "Zone");
    for (d = 0; d < DAYS; d++)
        printf("%7s%d", "Day", d + 1);
    printf("\n");
    for (z = 0; z < ZONES; z++)
    {
        printZoneName(z);
        for (d = 0; d < DAYS; d++)
            printf("%8.1f", temp[z][d]);
        printf("\n");
    }

    printf("\n--- HUMIDITY MATRIX (%%) ---\n%-15s", "Zone");
    for (d = 0; d < DAYS; d++)
        printf("%7s%d", "Day", d + 1);
    printf("\n");
    for (z = 0; z < ZONES; z++)
    {
        printZoneName(z);
        for (d = 0; d < DAYS; d++)
            printf("%8.1f", humidity[z][d]);
        printf("\n");
    }

    printf("\n--- AQI MATRIX ---\n%-15s", "Zone");
    for (d = 0; d < DAYS; d++)
        printf("%7s%d", "Day", d + 1);
    printf("\n");
    for (z = 0; z < ZONES; z++)
    {
        printZoneName(z);
        for (d = 0; d < DAYS; d++)
            printf("%8d", aqi[z][d]);
        printf("\n");
    }
}

void calculateAverages(float temp[ZONES][DAYS], float humidity[ZONES][DAYS], int aqi[ZONES][DAYS],
                       float avgTemp[ZONES], float avgHumidity[ZONES], float avgAQI[ZONES])
{
    int z, d;
    float sumT, sumH, sumA;
    for (z = 0; z < ZONES; z++)
    {
        sumT = 0;
        sumH = 0;
        sumA = 0;
        for (d = 0; d < DAYS; d++)
        {
            sumT += temp[z][d];
            sumH += humidity[z][d];
            sumA += aqi[z][d];
        }
        avgTemp[z] = sumT / DAYS;
        avgHumidity[z] = sumH / DAYS;
        avgAQI[z] = sumA / DAYS;
    }
}

void detectRiskZones(float temp[ZONES][DAYS], float humidity[ZONES][DAYS], int aqi[ZONES][DAYS],
                     int riskDays[ZONES])
{
    int z, d;
    printf("\n--- RISK DAY REPORT (AQI>150 OR Temp>35 OR Humidity>80) ---\n");
    for (z = 0; z < ZONES; z++)
    {
        riskDays[z] = 0;
        printZoneName(z);
        printf(": ");
        for (d = 0; d < DAYS; d++)
        {
            if (aqi[z][d] > 150 || temp[z][d] > 35 || humidity[z][d] > 80)
            {
                riskDays[z]++;
                printf("[Day %d] ", d + 1);
            }
        }
        if (riskDays[z] == 0)
            printf("No risk days");
        printf("  -> Risk days: %d\n", riskDays[z]);
    }
}

void computeGreenIndex(float avgTemp[ZONES], float avgHumidity[ZONES], float avgAQI[ZONES],
                       float greenIndex[ZONES])
{
    int z;
    float aqiScore, tempScore, humScore;
    for (z = 0; z < ZONES; z++)
    {
        aqiScore = clampZero(100 - (avgAQI[z] / 5));
        tempScore = clampZero(100 - 4 * absDiff(avgTemp[z], 25));
        humScore = clampZero(100 - 2 * absDiff(avgHumidity[z], 50));
        greenIndex[z] = 0.4f * aqiScore + 0.3f * tempScore + 0.3f * humScore;
    }
}

void displayRanking(float greenIndex[ZONES])
{
    int order[ZONES], rank[ZONES];
    int i, j, z, temp, better;

    /* rank = 1 + number of zones with a strictly higher index (ties share rank) */
    for (i = 0; i < ZONES; i++)
    {
        better = 0;
        for (j = 0; j < ZONES; j++)
            if (greenIndex[j] - greenIndex[i] > 0.0001f)
                better++;
        rank[i] = better + 1;
        order[i] = i;
    }

    /* sort zone order by rank (selection sort) */
    for (i = 0; i < ZONES - 1; i++)
        for (j = i + 1; j < ZONES; j++)
            if (rank[order[j]] < rank[order[i]])
            {
                temp = order[i];
                order[i] = order[j];
                order[j] = temp;
            }

    printf("\n--- GREEN INDEX RANKING (higher = better) ---\n");
    printf("%-6s %-15s %s\n", "Rank", "Zone", "Green Index");
    printf("------------------------------------\n");
    for (i = 0; i < ZONES; i++)
    {
        z = order[i];
        printf("%-6d ", rank[z]);
        printZoneName(z);
        printf("%.2f\n", greenIndex[z]);
    }
    printf("(Classroom comparison model, not an official environmental rating.)\n");
}

void displayRecommendations(float avgTemp[ZONES], float avgHumidity[ZONES], float avgAQI[ZONES],
                            int riskDays[ZONES])
{
    int z, flagged;
    printf("\n--- RECOMMENDATIONS ---\n");
    for (z = 0; z < ZONES; z++)
    {
        flagged = 0;
        printf("\n");
        printZoneName(z);
        printf("\n");
        if (avgAQI[z] > 150)
        {
            printf("  - Average AQI is high: reduce vehicle idling or improve ventilation.\n");
            flagged = 1;
        }
        if (avgTemp[z] > 35)
        {
            printf("  - Average temperature is high: add shade or green cover.\n");
            flagged = 1;
        }
        if (avgHumidity[z] > 80)
        {
            printf("  - Average humidity is high: check ventilation or stagnant-water sources.\n");
            flagged = 1;
        }
        if (flagged == 0)
        {
            if (riskDays[z] > 0)
                printf("  - Only individual days were flagged (%d): review those dates.\n", riskDays[z]);
            else
                printf("  - No risk detected: continue monitoring.\n");
        }
    }
}
